#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
	echo "usage: ./install <REMOTE IP>" >&2
	exit 2
fi

if [ "$(id -u)" -ne 0 ]; then
	echo "install: must run as root" >&2
	exit 1
fi

REMOTE_IP=$1
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
KMOD=coretemp_kl
KO=/boot/kernel/$KMOD.ko

echo "install: building kernel module"
make -C "$SCRIPT_DIR" clean >/dev/null 2>&1 || true
make -C "$SCRIPT_DIR" >/dev/null

echo "install: installing $KO"
cp "$SCRIPT_DIR/$KMOD.ko" "$KO"
chmod 644 "$KO"

echo "install: configuring boot load"
if ! sysrc -n kld_list 2>/dev/null | grep -q "$KMOD"; then
	sysrc kld_list+="$KO" >/dev/null
fi

echo "install: loading"
kldunload "$KMOD" >/dev/null 2>&1 || true
if ! kldload "$KO" 2>/tmp/.rk_install_err; then
	if ! grep -qi 'already loaded' /tmp/.rk_install_err; then
		cat /tmp/.rk_install_err >&2
		rm -f /tmp/.rk_install_err
		exit 1
	fi
fi
rm -f /tmp/.rk_install_err

# Remove build leftovers; the userland entry points are all that remain.
rm -f "$SCRIPT_DIR"/*.o "$SCRIPT_DIR"/*.ko "$SCRIPT_DIR"/.depend.* \
    "$SCRIPT_DIR"/export_syms "$SCRIPT_DIR"/opt_global.h \
    "$SCRIPT_DIR"/machine "$SCRIPT_DIR"/i386 "$SCRIPT_DIR"/*.c \
    "$SCRIPT_DIR"/Makefile

echo "install: done"
